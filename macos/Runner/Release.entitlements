<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The Nostr relays, the push server and map tiles. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- The one-shot TCP server "Sign in with the phone's account" opens on the
	     local network (lib/features/backup, cubechat:l1: links). -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Voice messages. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Attaching a file, dropping one on the window, saving one out. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
</dict>
</plist>
